{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "custom": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "sk-opencode-fixture-main-0001",
        "baseURL": "https://opencode.example-main.test/v1",
        "setCacheKey": true
      },
      "models": {
        "deepseek-v4-pro": { "name": "deepseek-v4-pro" },
        "glm-5.2": { "name": "glm-5.2" }
      }
    },
    "custom-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "options": {
        "apiKey": "sk-opencode-fixture-anthropic-0002",
        "baseURL": "https://opencode.example-anthropic.test/v1"
      },
      "models": {
        "claude-opus-5": { "name": "claude-opus-5" }
      }
    },
    "custom-broken": 42,
    "custom-no-base": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "apiKey": "sk-opencode-fixture-nobase-0003" },
      "models": {}
    },
    "custom-no-key": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { "baseURL": "https://opencode.example-nokey.test/v1" },
      "models": { "grok-4.6": { "name": "grok-4.6" } }
    }
  }
}
